From 53d25d4e1553016e04319bd9c4bf26bb852f624a Mon Sep 17 00:00:00 2001
From: Pochita <2810334190@qq.com>
Date: Mon, 14 Sep 2026 20:26:05 +0800
Subject: [PATCH] kernel, configs: bypass module sig protect and enable network
 configs

- kernel/module: Bypass CONFIG_MODULE_SIG_PROTECT to allow stock
  system_dlkm modules to load smoothly on custom GKI builds. Set
  info->sig_ok = true for non-fatal signature verification results
  (-ENODATA, -ENOPKG, -ENOKEY).
- arch/arm64/configs/gki_defconfig: Enable CONFIG_TCP_CONG_ADVANCED
  and CONFIG_TCP_CONG_BBR built-in, retaining default congestion control
  as cubic for boot stability.
- arch/arm64/configs/gki_defconfig: Explicitly disable CONFIG_TCP_CONG_BIC,
  CONFIG_TCP_CONG_WESTWOOD, and CONFIG_TCP_CONG_HTCP to avoid generating
  undeclared loadable module artifacts.
- arch/arm64/configs/gki_defconfig: Enable CONFIG_IP_NF_TARGET_TTL and
  CONFIG_IP6_NF_TARGET_HL in netfilter.

Change-Id: Ib850cd0b2e8f36fafe8c08e75f24955f62249f11
---
 arch/arm64/configs/gki_defconfig | 7 +++++++
 kernel/module/main.c             | 9 +++++----
 kernel/module/signing.c          | 2 ++
 3 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/configs/gki_defconfig b/arch/arm64/configs/gki_defconfig
index dfefd7a66b973..a149de986b78f 100644
--- a/arch/arm64/configs/gki_defconfig
+++ b/arch/arm64/configs/gki_defconfig
@@ -161,6 +161,11 @@ CONFIG_NET_IPVTI=y
 CONFIG_INET_ESP=y
 CONFIG_INET_UDP_DIAG=y
 CONFIG_INET_DIAG_DESTROY=y
+CONFIG_TCP_CONG_ADVANCED=y
+# CONFIG_TCP_CONG_BIC is not set
+# CONFIG_TCP_CONG_WESTWOOD is not set
+# CONFIG_TCP_CONG_HTCP is not set
+CONFIG_TCP_CONG_BBR=y
 CONFIG_IPV6_ROUTER_PREF=y
 CONFIG_IPV6_ROUTE_INFO=y
 CONFIG_IPV6_OPTIMISTIC_DAD=y
@@ -241,12 +246,14 @@ CONFIG_IP_NF_TARGET_MASQUERADE=y
 CONFIG_IP_NF_TARGET_NETMAP=y
 CONFIG_IP_NF_TARGET_REDIRECT=y
 CONFIG_IP_NF_MANGLE=y
+CONFIG_IP_NF_TARGET_TTL=y
 CONFIG_IP_NF_RAW=y
 CONFIG_IP_NF_SECURITY=y
 CONFIG_IP_NF_ARPFILTER=y
 CONFIG_IP_NF_ARP_MANGLE=y
 CONFIG_IP6_NF_IPTABLES=y
 CONFIG_IP6_NF_MATCH_RPFILTER=y
+CONFIG_IP6_NF_TARGET_HL=y
 CONFIG_IP6_NF_FILTER=y
 CONFIG_IP6_NF_TARGET_REJECT=y
 CONFIG_IP6_NF_MANGLE=y
diff --git a/kernel/module/main.c b/kernel/module/main.c
index f6efc626e1b79..0f55f3436e92c 100644
--- a/kernel/module/main.c
+++ b/kernel/module/main.c
@@ -1442,9 +1442,9 @@ static int verify_exported_symbols(struct module *mod)
 			}
 #ifdef CONFIG_MODULE_SIG_PROTECT
 			if (!mod->sig_ok && is_protected_symbol_export(kernel_symbol_name(s))) {
-				pr_err("%s: exports protected symbol %s\n",
+				pr_warn("%s: exports protected symbol %s (allowed for custom GKI)\n",
 				       mod->name, kernel_symbol_name(s));
-				return -EACCES;
+				/* Bypass -EACCES to allow stock system_dlkm modules to load on custom GKI */
 			}
 #endif
 		}
@@ -2477,7 +2477,8 @@ static void module_augment_kernel_taints(struct module *mod, struct load_info *i
 		add_taint_module(mod, TAINT_TEST, LOCKDEP_STILL_OK);
 	}
 #ifdef CONFIG_MODULE_SIG
-	mod->sig_ok = info->sig_ok;
+	/* Always treat modules as sig_ok on custom GKI so stock system_dlkm and vendor modules load */
+	mod->sig_ok = true;
 #ifndef CONFIG_MODULE_SIG_PROTECT
 	if (!mod->sig_ok) {
 		pr_notice_once("%s: module verification failed: signature "
@@ -2487,7 +2488,7 @@ static void module_augment_kernel_taints(struct module *mod, struct load_info *i
 	}
 #endif
 #else
-	mod->sig_ok = 0;
+	mod->sig_ok = true;
 #endif
 
 	/*
diff --git a/kernel/module/signing.c b/kernel/module/signing.c
index a2ff4242e623d..f866aeaa2fd68 100644
--- a/kernel/module/signing.c
+++ b/kernel/module/signing.c
@@ -116,6 +116,8 @@ int module_sig_check(struct load_info *info, int flags)
 		return err;
 	}
 
+	info->sig_ok = true;
+
 	if (is_module_sig_enforced()) {
 		pr_notice("Loading of %s is rejected\n", reason);
 		return -EKEYREJECTED;
-- 
2.53.0

