diff --git a/kernel/module.c b/kernel/module.c
index 93fade94f108..f5bca0e9f0c4 100644
--- a/kernel/module.c
+++ b/kernel/module.c
@@ -1352,9 +1352,9 @@ static int check_version(const struct load_info *info,
 	return 1;
 
 bad_version:
-	pr_warn("%s: disagrees about version of symbol %s\n",
+	pr_warn("%s: disagrees about version of symbol %s (allowed for custom GKI)\n",
 	       info->name, symname);
-	return 0;
+	return 1;
 }
 
 static inline int check_modstruct_version(const struct load_info *info,
@@ -2980,12 +2980,14 @@ static int module_sig_check(struct load_info *info, int flags)
 		return err;
 	}
 
+	info->sig_ok = true;
+
 	if (is_module_sig_enforced()) {
 		pr_notice("Loading of %s is rejected\n", reason);
 		return -EKEYREJECTED;
 	}
 
-	return security_locked_down(LOCKDOWN_MODULE_SIGNATURE);
+	return 0;
 }
 #else /* !CONFIG_MODULE_SIG */
 static int module_sig_check(struct load_info *info, int flags)
@@ -3291,9 +3293,9 @@ static int check_modinfo(struct module *mod, struct load_info *info, int flags)
 		if (err)
 			return err;
 	} else if (!same_magic(modmagic, vermagic, info->index.vers)) {
-		pr_err("%s: version magic '%s' should be '%s'\n",
+		pr_warn("%s: version magic '%s' should be '%s' (allowed for custom GKI)\n",
 		       info->name, modmagic, vermagic);
-		return -ENOEXEC;
+		/* Bypass -ENOEXEC for custom GKI */
 	}
 
 	if (!get_modinfo(info, "intree")) {
@@ -4058,13 +4060,10 @@ static int load_module(struct load_info *info, const char __user *uargs,
 		goto free_module;
 
 #ifdef CONFIG_MODULE_SIG
-	mod->sig_ok = info->sig_ok;
-	if (!mod->sig_ok) {
-		pr_notice_once("%s: module verification failed: signature "
-			       "and/or required key missing - tainting "
-			       "kernel\n", mod->name);
-		add_taint_module(mod, TAINT_UNSIGNED_MODULE, LOCKDEP_STILL_OK);
-	}
+	/* Always treat modules as sig_ok on custom GKI so stock system_dlkm and vendor modules load */
+	mod->sig_ok = true;
+#else
+	mod->sig_ok = true;
 #endif
 
 	/* To avoid stressing percpu allocator, do this once we're unique. */
